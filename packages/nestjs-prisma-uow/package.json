{
  "name": "@feneto/nestjs-prisma-uow",
  "version": "0.1.2",
  "description": "NestJS Prisma Unit of Work — transactional boundaries for DDD-style repositories",
  "license": "MIT",
  "author": "Fernando Neto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandonetom/nestjs-prisma-uow.git",
    "directory": "packages/nestjs-prisma-uow"
  },
  "homepage": "https://github.com/fernandonetom/nestjs-prisma-uow#readme",
  "bugs": {
    "url": "https://github.com/fernandonetom/nestjs-prisma-uow/issues"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "unit-of-work",
    "uow",
    "transaction",
    "ddd",
    "repository",
    "async-local-storage"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "prisma generate --schema=test/integration/prisma/schema.prisma && vitest run --config vitest.integration.config.ts"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@prisma/client": "^5.0.0 || ^6.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "prisma": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
